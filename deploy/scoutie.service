[Unit]
Description=Scoutie dashboard (live product UI)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/scoutie-app
Environment=PORT=5050
ExecStart=/home/ec2-user/scoutie-app/venv/bin/python -m scoutie.dashboard.api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
